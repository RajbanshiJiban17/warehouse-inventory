# Application Environment
ENVIRONMENT=development
APP_NAME="Warehouse Inventory System"
DEBUG=true

# Database (PostgreSQL URL or SQLite file)
# Example PostgreSQL: postgresql+psycopg://postgres:postgres@localhost:5432/inventory_db
# Example SQLite: sqlite:///./inventory.db
DATABASE_URL=sqlite:///./inventory.db

# Security & Tokens (Change in production! Min 32 characters)
SECRET_KEY=dev_secret_key_needs_to_be_at_least_32_characters_long_for_security_12345
REFRESH_SECRET_KEY=dev_refresh_secret_key_at_least_32_characters_long_inventory_secure_67890
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Seed Admin Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@inventory.local
ADMIN_INITIAL_PASSWORD=Admin@SecurePass2026!

# CORS (Comma separated list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_LOGIN="5/15minute"
RATE_LIMIT_DEFAULT="100/minute"
